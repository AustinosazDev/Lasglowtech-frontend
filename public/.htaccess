<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permanent redirect www → non-www (canonical)
  RewriteCond %{HTTP_HOST} ^www\.lasglowtech\.com\.ng [NC]
  RewriteRule ^(.*)$ https://lasglowtech.com.ng/$1 [R=301,L]

  # Prevent rewriting existing files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Redirect all other requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: Handle % encoded URLs (like %26 in your slug)
AddDefaultCharset utf-8
Options -MultiViews
