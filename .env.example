# Copy to `.env` for local development (never commit `.env`).
#
# Production / preview builds (Vercel, etc.): add these in the host’s
# Environment Variables UI so they exist when `npm run build` runs.

# Backend base URL (no trailing slash). Required if the API is not served from the same origin as the site.
# VITE_API_URL=https://api.lasglowtech.com.ng

# Set to `true` only if the API is intentionally reached via the same origin (e.g. reverse proxy to your API).
# Silences the console warning when VITE_API_URL is omitted.
# VITE_API_USE_SAME_ORIGIN=true
