# Copy to `.env` for local development (never commit `.env`).
#
# Production / preview builds (Vercel, etc.): add these in the host’s
# Environment Variables UI so they exist when `npm run build` runs.

# Backend base URL (no trailing slash). Set in your host’s build environment when the API
# is not on the same origin as this site (e.g. https://api.example.com).
# VITE_API_URL=https://api.lasglowtech.com.ng

# If VITE_API_URL is omitted, the app uses the site’s origin (same-origin / reverse-proxy setup).
